# Set one API key. Teller uses the first one it finds in this order:
# Gemini, Anthropic, OpenAI. With no key at all it uses a local Ollama model.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: force a provider (gemini, anthropic, openai or ollama)
LLM_PROVIDER=

# Optional: change the model for a provider
# GEMINI_MODEL=gemini-2.5-flash-lite
# ANTHROPIC_MODEL=
# OPENAI_MODEL=
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434
# OLLAMA_CONTEXT_SIZE=16384

# Optional: wait between LLM calls. Useful on free tiers with low rate limits.
# LLM_PAUSE_SECONDS=4
